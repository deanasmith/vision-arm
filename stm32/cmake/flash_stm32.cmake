find_program(OPENOCD openocd)
	if (OPENOCD)
		add_custom_target(flash ${OPENOCD} -f interface/stlink.cfg -f target/stm32f0x.cfg -c 'program "$<TARGET_FILE:vision-arm>" verify reset exit' DEPENDS vision-arm)
	else()
		find_program(CUBE cube)
		if (CUBE)
			add_custom_target(flash ${CUBE} programmer -c port=SWD -d "$<TARGET_FILE:vision-arm>" DEPENDS vision-arm)
		else()
			message(WARNING "Could not find programmer executable")
	endif()
endif()
